<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 2000px;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #0056b3;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
    <script>
        function filterReports() {
            //const filterDate = document.getElementById("filterDate").value;
            const filterType = document.getElementById("filterType").value;
            const rows = document.querySelectorAll(".report-row");

            rows.forEach(row => {
                //const rowDate = row.getAttribute("data-date");
                const rowType = row.getAttribute("data-type");

                //const dateMatch = !filterDate || rowDate === filterDate;
                const typeMatch = !filterType || rowType === filterType;

                //if (dateMatch && typeMatch) {
                if (typeMatch) {
                    row.style.display = "table-row";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function printPage() {
            const reportType = document.getElementById("filterType").value;
        }

        function createReport() {
            const reportType = document.getElementById("reportType").value; // Ensure this element exists
            console.log(`Report type: ${reportType}`);

            // Send a POST request to the server
            fetch('/add-report', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ alertType: reportType })
            })
            .then(response => {
                if (response.ok) {
                    console.log('Report generated successfully');
                    window.location.href = '/data_reports'; // Redirect if needed
                } else {
                    console.error('Error generating report');
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
</head>
<body>
    <div class="filter-section">
        <label for="filterType">Filter by Data Type:</label>
        <select id="filterType" onchange="filterReports()">
            <option value="">All</option>
            <option value="Temperature Alert">Temperature Alert</option>
            <option value="Intruder Alert">Intruder Alert</option>
            <option value="Temperature Fluctuation">Temperature Fluctuation</option>
            <option value="Power Fluctuation">Power Fluctuation</option>
            <option value="Humidity Fluctuation">Humidity Fluctuation</option>
            <option value="SoundLevel Fluctuation">SoundLevel Fluctuation</option>
        </select>
        {{!-- <label for="filterDate">Filter by Date:</label>
        <input type="date" id="filterDate" onchange="filterReports()"> --}}
    </div>

    <div class="report-table">
        <table>
            <thead>
                <tr>
                    <th>Alert Type</th>
                    <th>Alerts Triggered</th>
                    <th>Date Range</th>
                </tr>
            </thead>
            <tbody>
                {{#each alerts}}
                <tr class="report-row" data-date="{{date}}" data-type="{{alertType}}">
                    <td>{{alertType}}</td>
                    <td>{{amount}}</td>
                    <td>{{date}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="print-btn">
        <button class="btn" onclick="printPage()">Print Page</button>
    </div>
</body>
</html>
