<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 2000px;
            max-height: 500px;
            overflow-y: auto;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #0056b3;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
    <script>
        function filterReports() {
            const filterDate = document.getElementById("filterDate").value;
            const filterType = document.getElementById("filterType").value;
            const rows = document.querySelectorAll(".report-row");

            rows.forEach(row => {
                const rowDate = row.getAttribute("data-date");
                const rowType = row.getAttribute("data-type");

                const dateMatch = !filterDate || rowDate === filterDate;
                const typeMatch = !filterType || rowType === filterType;

                if (dateMatch && typeMatch) {
                    row.style.display = "table-row";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function printPage() {
            const reportType = document.getElementById("filterType").value;
        }

        function createReport() {
            const reportType = document.getElementById("reportType").value; // Ensure this element exists
            console.log(`Report type: ${reportType}`);

            // Send a POST request to the server
            fetch('/add-report', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ alertType: reportType })
            })
            .then(response => {
                if (response.ok) {
                    console.log('Report generated successfully');
                    window.location.href = '/data_reports'; // Redirect if needed
                } else {
                    console.error('Error generating report');
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
</head>
<body>
    <div class="filter-section">
        <label for="filterType">Filter by Data Type:</label>
        <select id="filterType" onchange="filterReports()">
            <option value="">All</option>
            <option value="Statistics">Statistics</option>
            <option value="Alerts">Alerts</option>
            <option value="Inventory">Inventory</option>
        </select>
        <label for="filterDate">Filter by Date:</label>
        <input type="date" id="filterDate" onchange="filterReports()">
    </div>

    <div class="report-table">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Report Name</th>
                    <th>Data Type</th>
                    <th>Description</th>
                    <th>Report Details</th>
                </tr>
            </thead>
            <tbody>
                {{#each reports}}
                <tr class="report-row" data-date="{{date}}" data-type="{{report}}">
                    <td>{{formatDate date}}</td>
                    <td>{{reportName}}</td>
                    <td>{{report}}</td>
                    <td>{{description}}</td>
                    <td><a href="/view-report?report={{report}}&date={{date}}" target="_blank">View Report</a></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <form action="/add-report" method="POST">
    <div class="print-btn">
        {{!-- <button class="btn" onclick="printPage()">Print Page</button> --}}

        <div class="filter-section">
            <label for="reportType">Select type of Report</label>
            <select name="reportType" id="reportType">
                <option value="Statistics">Statistics</option>
                <option value="Alerts">Alerts</option>
                <option value="Inventory">Inventory</option>
            </select>
        </div>
        <button class="btn" type="submit">Generate Report</button>
    </div>
    </form>
</body>
</html>



