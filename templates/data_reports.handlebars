<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ThermoGuard Data Reports</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f9;
            margin: 0;
            padding: 0;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            padding: 20px;
        }
        .chart-container {
            width: 39%;
            height: 80%;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            position: relative;
        }
        canvas {
            width: 100% !important;
            height: 300px !important;
        }

        select {
            width:auto !important;
        }
        #printChartButton {
                float: right;
                width: 20px;
                position: absolute;
                right: 20px;
                top: 20px;
                height: 31px;
                cursor: pointer;
        }
        
    </style>
</head>
<body>
    <div class="container">
        <div class="chart-container">
            <select class="form-control form-control-sm" id="monthRangeDropdown">
                <option value="1">Last 1 Month</option>
                <option value="2">Last 2 Months</option>
                <option value="3">Last 3 Months</option>
                <option value="4">Last 4 Months</option>
                <option value="5">Last 5 Months</option>
                <option value="6">Last 6 Months</option>
                <option value="7">Last 7 Months</option>
                <option value="8">Last 8 Months</option>
                <option value="9">Last 9 Months</option>
                <option value="10">Last 10 Months</option>
                <option value="11">Last 11 Months</option>
                <option value="12">Last 12 Months</option>
            </select>

            <h2>Alerts Monitoring</h2>
            <svg class="nav-icon" id="printChartButton">
                <use xlink:href="vendors/@coreui/icons/svg/free.svg#cil-print"></use>
            </svg>
            <canvas id="alertsChart"></canvas>
        </div>

        <div class="chart-container">
            <h2>Sound Level Monitoring</h2>
            <canvas id="soundChart"></canvas>
        </div>
        <div class="chart-container">
            <h2>Humidity Levels</h2>
            <canvas id="humidityChart"></canvas>
        </div>
        <div class="chart-container">
            <h2>Power Consumption</h2>
            <canvas id="powerChart"></canvas>
        </div>
    </div>
    <script>
        // Temperature Line Chart
        const alerts = {{{alerts}}};
        let tooltipData = [];
        console.log('First 10 Alerts:', alerts.slice(0, 10));
       // Group data by alertType
        const groupData = (filteredAlerts) => {
            return filteredAlerts.reduce((acc, alert) => {
                if (!acc[alert.alertType]) {
                    acc[alert.alertType] = {
                        count: 0,
                        totalTemperature: 0,
                        totalHumidity: 0,
                        criticalCount: 0
                    };
                }
                acc[alert.alertType].count++;
                acc[alert.alertType].totalTemperature += alert.temperature || 0;
                acc[alert.alertType].totalHumidity += alert.humidity || 0;
                if (alert.status === "Critical") {
                    acc[alert.alertType].criticalCount++;
                }
                return acc;
            }, {});
        };

        // Filter alerts by the last N months
        const filterByMonthRange = (alerts, monthsRange) => {
            const currentDate = new Date();
            const startDate = new Date();
            startDate.setMonth(currentDate.getMonth() - monthsRange);

            return alerts.filter(alert => {
                const alertDate = new Date(alert.time);
                return alertDate >= startDate && alertDate <= currentDate;
            });
        };

        // Render chart
        const renderChart = (filteredAlerts) => {
            const groupedData = groupData(filteredAlerts);

            const alertTypes = Object.keys(groupedData);
            const alertCounts = alertTypes.map(type => groupedData[type].count);
            const avgTemperatures = alertTypes.map(type => groupedData[type].totalTemperature / groupedData[type].count || 0);
            const avgHumidities = alertTypes.map(type => groupedData[type].totalHumidity / groupedData[type].count || 0);
            const criticalCounts = alertTypes.map(type => groupedData[type].criticalCount);

            // Destroy the old chart if it exists
            if (window.alertChartInstance) {
                window.alertChartInstance.destroy();
            }

            // Create the new chart
            const ctx = document.getElementById('alertsChart').getContext('2d');

            
            window.alertChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: alertTypes, // Dynamic alert types
                    datasets: [
                        {
                            label: 'Alert Count',
                            data: alertCounts,
                            backgroundColor: '#42a5f5',
                            borderColor: '#1e88e5',
                            borderWidth: 1
                        },
                        {
                            label: 'Average Temperature (°C)',
                            data: avgTemperatures,
                            backgroundColor: '#ff7043',
                            borderColor: '#e64a19',
                            borderWidth: 1
                        },
                        {
                            label: 'Average Humidity (%)',
                            data: avgHumidities,
                            backgroundColor: '#66bb6a',
                            borderColor: '#388e3c',
                            borderWidth: 1
                        },
                        {
                            label: 'Critical Alerts',
                            data: criticalCounts,
                            backgroundColor: '#ef5350',
                            borderColor: '#d32f2f',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                afterBody: function (context) {
                                    const index = context[0].dataIndex;
                                    tooltipData[index] = {
                                        alertType: alertTypes[index],
                                        alertCount: alertCounts[index],
                                        avgTemperature: avgTemperatures[index],
                                        avgHumidity: avgHumidities[index],
                                        criticalAlerts: criticalCounts[index]
                                    };
                                    return `Critical Alerts: ${criticalCounts[index]}`;
                                }
                            }
                        },
                        legend: {
                            position: 'top',
                        },
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Alert Types'
                            }
                        },
                        y: {
                            title: {
                                display: true,
                                text: 'Values'
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        };

        // Initialize chart with the last 1 month range
        renderChart(filterByMonthRange(alerts, 1));

        // Add change event for the dropdown
        document.getElementById('monthRangeDropdown').addEventListener('change', (event) => {
            const selectedRange = parseInt(event.target.value, 10);
            const filteredAlerts = filterByMonthRange(alerts, selectedRange);
            renderChart(filteredAlerts);
        });

        //Alert table for print page.
        function generateTooltipTable() {
            let tableHTML = `
                <table style="width: 80%; margin: 20px auto; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr>
                            <th style="border: 1px solid #ddd; padding: 8px;">Alert Type</th>
                            <th style="border: 1px solid #ddd; padding: 8px;">Alert Count</th>
                            <th style="border: 1px solid #ddd; padding: 8px;">Average Temperature (°C)</th>
                            <th style="border: 1px solid #ddd; padding: 8px;">Average Humidity (%)</th>
                            <th style="border: 1px solid #ddd; padding: 8px;">Critical Alerts</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            tooltipData.forEach((data) => {
                tableHTML += `
                    <tr>
                        <td style="border: 1px solid #ddd; padding: 8px;">${data.alertType}</td>
                        <td style="border: 1px solid #ddd; padding: 8px;">${data.alertCount}</td>
                        <td style="border: 1px solid #ddd; padding: 8px;">${data.avgTemperature}</td>
                        <td style="border: 1px solid #ddd; padding: 8px;">${data.avgHumidity}</td>
                        <td style="border: 1px solid #ddd; padding: 8px;">${data.criticalAlerts}</td>
                    </tr>
                `;
            });

            tableHTML += `
                    </tbody>
                </table>
            `;

            return tableHTML;
        }

        //print functionality
        document.getElementById('printChartButton').addEventListener('click', (event) => {
            // Create a new window or tab
            const printWindow = window.open('', '_blank');

            // Get the canvas element
            const canvas = document.getElementById('alertsChart');

            // Convert canvas to an image
            const chartImage = canvas.toDataURL('image/png');

            // Generate a tooltip data table
            const tooltipTable = generateTooltipTable();

            // Generate HTML for the print window
            printWindow.document.write(`
                <html>
                    <head>
                        <title>Print Chart</title>
                        <style>
                            body {
                                text-align: center;
                                font-family: Arial, sans-serif;
                            }
                            h2 {
                                margin-bottom: 20px;
                            }
                            img {
                                max-width: 100%;
                                height: auto;
                                margin-bottom: 20px;
                            }
                            table {
                                border-collapse: collapse;
                                width: 90%;
                                margin: 0 auto;
                            }
                            th, td {
                                border: 1px solid #ddd;
                                padding: 8px;
                                text-align: left;
                            }
                            th {
                                background-color: #f4f4f4;
                            }
                        </style>
                    </head>
                    <body>
                        <h2>Alerts Monitoring</h2>
                        <img src="${chartImage}" alt="Alerts Chart" />
                        ${tooltipTable}
                        <script>
                            window.onload = function() { window.print(); };
                        </` + `script>
                    </body>
                </html>
            `);

            // Close the document to render the content
            printWindow.document.close();
        });



        // Sound Level Radar Chart
        const soundCtx = document.getElementById('soundChart').getContext('2d');
        new Chart(soundCtx, {
            type: 'radar',
            data: {
                labels: ['5am', '8am', '11am', '1pm', '4pm', '7pm'],
                datasets: [{
                    label: 'Sound Level (dB)',
                    data: [30, 35, 40, 38, 42, 40],
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderWidth: 2
                }]
            },
            options: {
                scales: { r: { beginAtZero: true } }
            }
        });

        // Humidity Doughnut Chart
        const humidityCtx = document.getElementById('humidityChart').getContext('2d');
        new Chart(humidityCtx, {
            type: 'doughnut',
            data: {
                labels: ['Ideal Humidity', 'Current Humidity'],
                datasets: [{
                    label: 'Humidity (%)',
                    data: [50, 52], // Replace with actual data, where 50 is the target, and 52 is the latest reading
                    backgroundColor: ['rgba(75, 192, 192, 0.6)', 'rgba(50, 192, 50, 0.6)']
                }]
            },
            options: {
                plugins: { legend: { position: 'top' } }
            }
        });

        // Power Consumption Polar Area Chart
        const powerCtx = document.getElementById('powerChart').getContext('2d');
        new Chart(powerCtx, {
            type: 'polarArea',
            data: {
                labels: ['5am', '8am', '11am', '1pm', '4pm', '7pm'],
                datasets: [{
                    label: 'Power Consumption (kW)',
                    data: [5, 6, 7, 6, 5, 8],
                    backgroundColor: [
                        'rgba(255, 159, 64, 0.2)',
                        'rgba(255, 159, 64, 0.4)',
                        'rgba(255, 159, 64, 0.6)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(255, 159, 64, 1)'
                    ]
                }]
            },
            options: {
                scales: { r: { beginAtZero: true } }
            }
        });
    </script>
</body>
</html>





