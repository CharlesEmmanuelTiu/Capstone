<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 2000px;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #0056b3;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
    <script>
        function filterReports() {
            const filterDate = document.getElementById("filterDate").value;
            const filterType = document.getElementById("filterType").value;
            const rows = document.querySelectorAll(".report-row");

            rows.forEach(row => {
                const rowDate = row.getAttribute("data-date");
                const rowType = row.getAttribute("data-type");

                const dateMatch = !filterDate || rowDate === filterDate;
                const typeMatch = !filterType || rowType === filterType;

                if (dateMatch && typeMatch) {
                    row.style.display = "table-row";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function printPage() {
            window.print();
        }
    </script>
</head>
<body>
    <div class="filter-section">
        <label for="filterType">Filter by Data Type:</label>
        <select id="filterType" onchange="filterReports()">
            <option value="">All</option>
            <option value="Statistics">Statistics</option>
            <option value="Alerts">Alerts</option>
            <option value="Inventory">Inventory</option>
        </select>
        <label for="filterDate">Filter by Date:</label>
        <input type="date" id="filterDate" onchange="filterReports()">
    </div>

    <div class="report-table">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Report Name</th>
                    <th>Data Type</th>
                    <th>Description</th>
                    <th>Report Details</th>
                </tr>
            </thead>
            <tbody>
                <tr class="report-row" data-date="2024-11-20" data-type="Statistics">
                    <td>2024-11-20</td>
                    <td>thermoguard_report-20241120</td>
                    <td>Statistics</td>
                    <td>Visual Summary</td>
                    <td><a href="/data_reports">View Report</a></td>
                </tr>
                <tr class="report-row" data-date="2024-11-21" data-type="Alerts">
                    <td>2024-11-21</td>
                    <td>thermoguard_report-20241121</td>
                    <td>Alerts</td>
                    <td>Alerts Summary</td>
                    <td><a href="">View Report</a></td>
                </tr>
                <tr class="report-row" data-date="2024-11-23" data-type="Alerts">
                    <td>2024-11-23</td>
                    <td>thermoguard_report-20241123</td>
                    <td>Alerts</td>
                    <td>Alerts Summary</td>
                    <td><a href="report3.html" target="_blank">View Report</a></td>
                </tr>
                <tr class="report-row" data-date="2024-11-25" data-type="Inventory">
                    <td>2024-11-25</td>
                    <td>thermoguard_report-20241125</td>
                    <td>Inventory</td>
                    <td>Components Summary</td>
                    <td><a href="report4.html" target="_blank">View Report</a></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="print-btn">
        <button class="btn" onclick="printPage()">Print Page</button>
    </div>
</body>
</html>



