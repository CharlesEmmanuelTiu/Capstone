<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        .chart-container {
            align-self: center;
            width: 80%;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }
        canvas {
            width: 100% !important;
            height: 500px !important;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 2000px;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #4f5d73;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #007bff;
            color: white;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@2.3.0/build/global/luxon.min.js"></script>
    <h1>Statistics Report for {{formatDate date}}</h1>
    <div class="chart-container">
        <canvas id="TempPrediction" width="400" height="200"></canvas>
    </div>


    <div class="print-btn">
        <button class="btn" onclick="printPage()">Print Page</button>
    </div>
    <script>
        function printPage() {
            const reportType = document.getElementById("filterType").value;
        }
    </script>
    <script>
    const ctx = document.getElementById('TempPrediction').getContext('2d');
    const TempPredictionChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [],  // Dynamic labels
               datasets: [
                {
                    label: 'Temperature (°C)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(255, 0, 0, 1)',
                    backgroundColor: 'rgba(255, 0, 0, 0.2)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                },
                {
                    label: 'Power Consumption (W)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(255, 138, 0, 1)',
                    backgroundColor: 'rgba(255, 138, 0, 0.2)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                },
                {
                    label: 'Humidity (%)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(0, 170, 255, 1)',
                    backgroundColor: 'rgba(0, 75, 255, 0.2)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                },
                {
                    label: 'Water Leakage',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(0, 32, 255, 1)',
                    backgroundColor: 'rgba(0, 32, 255, 0.2)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                },
                {
                    label: 'Sound Levels',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(80, 209, 0, 1)',
                    backgroundColor: 'rgba(80, 209, 0, 0.2)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                },
            ],
        },
        options: {
            responsive: true,
            scales: {
                x: { title: { display: true, text: 'Time' } },
                y: { title: { display: true, text: 'Values' }, beginAtZero: true }
            }
        }
    });

        function updateChart(data) {
        // Ensure timestamps are valid Date objects for Chart.js
        const timeLabels = data.map(entry => new Date(entry.time).toISOString().split('T')[0]); // Format: YYYY-MM-DD
        const temperatureData = data.map(entry => entry.temperature);
        const powerData = data.map(entry => entry.power);
        const humidityData = data.map(entry => entry.humidity);
        const waterData = data.map(entry => entry.water);
        const micData = data.map(entry => entry.mic_decibels);

        // Update the chart with the new data
        TempPredictionChart.data.labels = timeLabels;
        TempPredictionChart.data.datasets[0].data = temperatureData;
        TempPredictionChart.data.datasets[1].data = powerData;
        TempPredictionChart.data.datasets[2].data = humidityData;
        TempPredictionChart.data.datasets[3].data = waterData;
        TempPredictionChart.data.datasets[4].data = micData;

        // Re-render the chart
        TempPredictionChart.update();
    }
    const data = JSON.parse('{{{data}}}');
    const smallData = data.slice(0, 10); 
    console.log(data[1])
    const testData = [
        { timestamp: '2024-11-26T14:00:00Z', temperature: 22, power: 120, humidity: 45 },
        { timestamp: '2024-11-26T14:05:00Z', temperature: 23, power: 130, humidity: 50 },
        { timestamp: '2024-11-26T14:10:00Z', temperature: 24, power: 125, humidity: 48 }
    ];
    console.log(testData[1])
    updateChart(data); 
    </script>
</body>
</html>
