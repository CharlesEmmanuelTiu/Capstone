        function setFanSpeed() {
            const fanSpeedValue = document.getElementById("internal-fan-speed").value;
            console.log(`Internal Fan Speed set to: ${fanSpeedValue}%`);
        }

        function setInternalTemp() {
            const tempValue = document.getElementById("internal-temp").value;
            console.log(`Internal Temperature set to: ${tempValue}°C`);
        }

        function setInternalHumidity() {
            const humidityValue = document.getElementById("internal-humidity").value;
            console.log(`Internal Humidity set to: ${humidityValue}%`);
