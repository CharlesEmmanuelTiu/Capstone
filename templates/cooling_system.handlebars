            const systemType = document.getElementById("cooling-system").value;
            const externalCracControls = document.getElementById("external-crac-controls");
            const internalCracControls = document.getElementById("internal-crac-controls");
            const rackSelection = document.getElementById("rack-selection");

            // Hide all control sections initially
            externalCracControls.classList.add("hidden");
            internalCracControls.classList.add("hidden");
            rackSelection.classList.add("hidden");

            if (systemType === "external") {
                externalCracControls.classList.remove("hidden");
            } else if (systemType === "internal") {
                internalCracControls.classList.remove("hidden");
                rackSelection.classList.remove("hidden");
