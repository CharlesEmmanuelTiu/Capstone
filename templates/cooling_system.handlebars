            const cracStatus = document.getElementById("crac-status");

            if (cracTemp.disabled) {
                cracTemp.disabled = false;
                cracHumidity.disabled = false;
                cracStatus.classList.add("hidden");
                button.textContent = "Set to Automatic";
            } else {
                cracTemp.disabled = true;
                cracHumidity.disabled = true;
                cracStatus.classList.remove("hidden");
                button.textContent = "Set to Manual";
            }
