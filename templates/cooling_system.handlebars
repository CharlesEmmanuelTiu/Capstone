                    <label>Humidity (%)</label>
                    <div class="crac-settings">
                        <input
                            type="number"
                            id="crac-humidity"
                            value="50"
                            min="20"
                            max="80"
                            step="1"
                        />
                        <button id="set-humidity" onclick="setHumidity()">Set</button>
