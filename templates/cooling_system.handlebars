            const humidityValue = document.getElementById("crac-humidity").value;
            console.log(`CRAC Humidity set to: ${humidityValue}%`);
            document.getElementById("humidity-confirmation").classList.remove("hidden");
        }

        function updateFanSpeed() {
            const fanSpeedValue = document.getElementById("internal-fan-speed").value;
            document.getElementById("fan-speed-value").textContent = `${fanSpeedValue}%`;
        }

        function logSettings() {
            const log = document.getElementById("log");
            const temp = document.getElementById("crac-temp").value;
            const humidity = document.getElementById("crac-humidity").value;
            const internalFanSpeed = document.getElementById("internal-fan-speed").value;

            log.innerHTML = `
                <p><strong>CRAC Temperature:</strong> ${temp}°C</p>
                <p><strong>CRAC Humidity:</strong> ${humidity}%</p>
                <p><strong>Internal Fan Speed:</strong> ${internalFanSpeed}%</p>
            `;
            log.classList.remove("hidden");

            // Hide the confirmation messages when saving settings
            document.getElementById("temp-confirmation").classList.add("hidden");
            document.getElementById("humidity-confirmation").classList.add("hidden");
        }
    </script>
</body>
