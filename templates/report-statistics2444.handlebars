<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Center Temperature Prediction</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f9;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            padding: 20px;
        }
        .chart-container {
            width: 80%;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }
        canvas {
            width: 100% !important;
            height: 500px !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="chart-container">
            <h2>Statistics Report for {{formatDate date}}</h2>
            <canvas id="TempPrediction"></canvas>
        </div>
    </div>
<script>
    // Create and update the line chart
    const ctx = document.getElementById('TempPrediction').getContext('2d');
    const TempPredictionChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [], // This will be populated dynamically
            datasets: [
                {
                    label: 'Temperature (°C)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(255, 99, 132, 1)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    fill: false,
                },
                {
                    label: 'Power Consumption (W)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    fill: false,
                },
                {
                    label: 'Humidity (%)',
                    data: [],  // This will be populated dynamically
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: false,
                },
            ],
        },
        options: {
            responsive: true,
            scales: {
                x: {
                    type: 'time', // Use time scale for the x-axis
                    time: {
                        unit: 'minute',
                        tooltipFormat: 'll HH:mm',
                        displayFormats: {
                            minute: 'YYYY-MM-DD HH:mm', // Formatting for minute-level data
                        },
                    },
                    title: { display: true, text: 'Time' },
                },
                y: {
                    title: { display: true, text: 'Temperature (°C)' },
                },
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return `${tooltipItem.dataset.label}: ${tooltipItem.raw}`;
                        },
                    },
                },
            },
        }

    });

    function updateChart(data) {
        // Ensure timestamps are valid Date objects for Chart.js
        const timeLabels = data.map(entry => new Date(entry.timestamp)); // Convert to Date object
        const temperatureData = data.map(entry => entry.temperature);
        const powerData = data.map(entry => entry.power);
        const humidityData = data.map(entry => entry.humidity);

        // Update the chart with the new data
        chart.data.labels = timeLabels;
        chart.data.datasets[0].data = temperatureData;
        chart.data.datasets[1].data = powerData;
        chart.data.datasets[2].data = humidityData;

        // Re-render the chart
        chart.update();
    }

    const testData = [
        { timestamp: '2024-11-26T14:00:00Z', temperature: 22, power: 120, humidity: 45 },
        { timestamp: '2024-11-26T14:05:00Z', temperature: 23, power: 130, humidity: 50 },
        { timestamp: '2024-11-26T14:10:00Z', temperature: 24, power: 125, humidity: 48 }
    ];
    updateChart(testData); 
</script>

</body>
</html>