    <script>
        const ALERT_THRESHOLDS = {
            temperature: 3,
            sound: 5,
            humidity: 10,
            power: 2
        };

        document.getElementById("NumberOfAlerts").innerHTML = 0
        document.getElementById("currentStatus").innerHTML = "Optimal"
        document.getElementById("currentStatus").style.backgroundColor = "green";
        document.getElementById('currentStatus2').style.backgroundColor = "green";
        // Initialize charts and data arrays
        const temperatureProactive = tempProChart(document.getElementById('temperatureProactive').getContext('2d'), 'Temperature (°C)');
        const soundProactive = soundProChart(document.getElementById('soundProactive').getContext('2d'), 'Sound Level (dB)');
        const humidityProactive = humidProChart(document.getElementById('humidityProactive').getContext('2d'), 'Humidity (%)');
        const powerProactive = powerProChart(document.getElementById('powerProactive').getContext('2d'), 'Power Consumption (kW)');
        const tempProData = Array(10).fill(null);
        const tempProTime = Array(10).fill("");
        const humidityProData = Array(10).fill(null);
        const humidityProTime = Array(10).fill("");
        const powerProData = Array(10).fill(null);
        const powerProTime = Array(10).fill("");
        const soundProData = Array(10).fill(null);
        const soundProTime = Array(10).fill("");

        const randomDataGenerator = (min, max) => (Math.random() * (max - min) + min).toFixed(1);

        var gauge = drawLinearGauge(70);
        var thermometer = gauge.thermometer(0);
        thermometer.name('Thermometer').fill('green').stroke('green');
        gauge.container('thermometerContainer');
        gauge.draw();

        function monitorMetric(alert, metricId, logId, dataArr, timeArr, chart, min, max, threshold, data){
                let currentValue;
                if (metricId === "sound") {
                    // Use random generation for sound
                    currentValue = parseFloat(randomDataGenerator(min, max));
                } else {
                    // Fetch actual data for temperature, power, or humidity
                    try {
                        // Use the actual data for the corresponding metric
                        if (data && data[metricId] !== undefined) {
                            currentValue = parseFloat(data[metricId]);
                        } else {
                            currentValue = randomDataGenerator(min, max); // Fallback to random data
                        }
                    } catch (error) {
                        console.error("Error fetching data:", error);
                        currentValue = randomDataGenerator(min, max); // Fallback to random data
                    }
                }
                data = {
                                temperature: data.temperature,
                                humidity: data.humidity,
                                power: data.power,
                                sound: currentValue
                            }
                // Capture current time for the x-axis label
                const currentTime = new Date().toLocaleTimeString();
                
                // Update data and labels
                timeArr.push(currentTime);
                timeArr.shift();
                dataArr.push(currentValue);
                dataArr.shift();
                // Update the chart labels and data
                chart.data.labels = timeArr;
                chart.data.datasets[0].data = dataArr;
                chart.update();

                // Check for threshold breach
                if (Math.abs(currentValue - dataArr[dataArr.length - 2]) > threshold) {
                    console.log("OOOOOH YEAH")
                    addAlertRow(alert, "Dashboard", "Warning", new Date(), data);
                    //addAlertRow("Temperature Alert", "Cooling System", "Warning", new Date(), temperature, humidity);
                }
        }

        // Initialize the Humidity Gauge
        var target = document.getElementById('humidityContainer');
        var HumidityGauge = new Gauge(target).setOptions({
            angle: 0,
            lineWidth: 0.2,
            radiusScale: 1,
            pointer: { length: 0.6, strokeWidth: 0.04, color: '#000000' },
            colorStart: '#6FADCF',
            colorStop: '#8FC0DA',
            strokeColor: '#E0E0E0',
            generateGradient: true
        });
        HumidityGauge.maxValue = 100;
        HumidityGauge.setMinValue(0);
        HumidityGauge.animationSpeed = 32;

        function addLabel(value) {
            var ctx = target.getContext('2d');
            ctx.font = "20px Arial";
            ctx.textAlign = "center";
            ctx.fillStyle = "#000000";

            ctx.clearRect(0, target.height - 40, target.width, 50);
            ctx.fillText(value + "% Humidity", target.width / 2, target.height - 5);
        }

        function drawLinearGauge(value) {
            var gauge = anychart.gauges.linear();
            gauge.data([value]).padding(10, 0, 30, 0);
            gauge.tooltip().useHtml(true).format(function () {
                return this.value + '°C (' + (this.value * 1.8 + 32).toFixed(1) + '°F)';
            });

            var scale = gauge.scale();
            scale.minimum(10).maximum(50).ticks({ interval: 5 });

            var axis = gauge.axis();
            axis.scale(scale).width('0.5%').offset('-1%');
            axis.labels().useHtml(true).format('{%Value}°C');

            return gauge;
        }

        // Fetch data and update everything
        async function fetchDataAndUpdate() {
            try {
                const response = await fetch('http://127.0.0.1:5005/data');
                const data = await response.json();
                const { temperature, humidity, power } = data;
                // Update the dashboard
                HumidityGauge.set(humidity);
                addLabel(humidity);
            
                gauge.data([temperature]);
                document.getElementById('currentTemperature').textContent = temperature + ' °C';
                document.getElementById('currentHumidity').textContent = humidity + ' %'
                const currentStatus2 = document.getElementById('currentStatus2');
                if (humidity >= 20 && humidity <= 80) {
                    currentStatus2.style.backgroundColor = 'green';
                    currentStatus2.innerHTML = 'Normal';
                } else if (humidity > 80) {
                    currentStatus2.style.backgroundColor = 'red';
                    currentStatus2.innerHTML = 'High';
                } else {
                    currentStatus2.style.backgroundColor = 'orange';
                    currentStatus2.innerHTML = 'Low';
                }

                const currentStatus = document.getElementById("currentStatus");
                const currentData = { temperature, humidity, power }
                if (temperature > 35) {
                    currentStatus.innerHTML = "Danger";
                    currentStatus.style.backgroundColor = "red";
                    thermometer.name('Thermometer').fill('red').stroke('red');
                    addAlertRow("Temperature Alert", "Cooling System", "Critical", new Date(), currentData);
                } else if (temperature > 27) {
                    currentStatus.innerHTML = "Risk";
                    currentStatus.style.backgroundColor = "orange";
                    thermometer.name('Thermometer').fill('orange').stroke('orange');
                    addAlertRow("Temperature Alert", "Cooling System", "Warning", new Date(), currentData);
                } else {
                    currentStatus.innerHTML = "Optimal";
                    currentStatus.style.backgroundColor = "green";
                    thermometer.name('Thermometer').fill('green').stroke('green');
                }

                // Update proactive monitoring charts
                const currentTime = new Date().toLocaleTimeString();
                monitorMetric("Temperature Fluctuation", "temperature", "tempLog", tempProData, tempProTime, temperatureProactive, 20, 30, ALERT_THRESHOLDS.temperature, currentData);
                monitorMetric("SoundLevel Fluctuation", "sound", "soundLog", soundProData, soundProTime, soundProactive, 30, 50, ALERT_THRESHOLDS.sound, currentData);
                monitorMetric("Humidity Fluctuation", "humidity", "humidityLog", humidityProData, humidityProTime, humidityProactive, 40, 60, ALERT_THRESHOLDS.humidity, currentData);
                monitorMetric("Power Fluctuation", "power" ,"powerLog", powerProData, powerProTime, powerProactive, 0.5, 5, ALERT_THRESHOLDS.power, currentData);
            } catch (error) {
                console.error("Error fetching data:", error);
            }
        }

        function updateChart(chart, dataArr, timeArr, currentTime, newValue) {
            timeArr.push(currentTime);
            timeArr.shift();
            dataArr.push(newValue);
            dataArr.shift();
            chart.data.labels = timeArr;
            chart.data.datasets[0].data = dataArr;
            chart.update();
        }

        function addAlertRow(alertType, source, status, time, currentData) {
            const alertTableBody = document.getElementById("alertTableBody");
            const noAlertsRow = document.getElementById("noAlertsRow");
            
            if (noAlertsRow) {
                alertTableBody.removeChild(noAlertsRow);
            }

            const rows = alertTableBody.getElementsByTagName("tr");
            for (let i = 0; i < rows.length; i++) {
                const cells = rows[i].getElementsByTagName("td");
                if (
                    cells[1].innerText === source &&
                    cells[2].innerText === status
                ) {
                    return;
                }
            }

            const newRow = alertTableBody.insertRow();
            if(alertType=="Temperature Alert"){
                newRow.insertCell(0).innerHTML = `<img src="https://cdn-icons-png.flaticon.com/128/5641/5641074.png" alt="${alertType}" title="${alertType}" class="icon-small">`;
            } else if(alertType=="Temperature Fluctuation"){
                newRow.insertCell(0).innerHTML = `<img src="https://cdn-icons-png.flaticon.com/512/15788/15788427.png" alt="${alertType}" title="${alertType}" class="icon-small">`;
            } else if(alertType=="Humidity Fluctuation"){
                newRow.insertCell(0).innerHTML = `<img src="https://cdn-icons-png.flaticon.com/512/5664/5664982.png" alt="${alertType}" title="${alertType}" class="icon-small">`;
            } else if(alertType=="Power Fluctuation"){
                newRow.insertCell(0).innerHTML = `<img src="https://cdn-icons-png.flaticon.com/256/6368/6368706.png" alt="${alertType}" title="${alertType}" class="icon-small">`;
            } else if(alertType=="SoundLevel Fluctuation"){
                newRow.insertCell(0).innerHTML = `<img src="https://cdn-icons-png.freepik.com/512/4040/4040118.png" alt="${alertType}" title="${alertType}" class="icon-small">`;
            }
            newRow.insertCell(1).innerHTML = `<a class="alert-links" href="/cooling_system">${source}</a>`;
            newRow.insertCell(2).textContent = status;
            newRow.insertCell(3).textContent = time.toLocaleTimeString();

            document.getElementById("NumberOfAlerts").innerHTML = parseInt(document.getElementById("NumberOfAlerts").innerHTML) + 1;
        }

        // Initialize proactive monitoring
        function tempProChart(ctx, label) {
            return new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array(10).fill(""),
                    datasets: [{
                        label: label,
                        data: Array(10).fill(null),
                        borderColor: 'rgba(255, 0, 0, 1)',
                        backgroundColor: 'rgba(255, 0, 0, 0.2)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true },
                        x: { 
                            ticks: { autoSkip: true, maxTicksLimit: 5 }
                        }
                    }
                }
            });
        }

        function humidProChart(ctx, label) {
            return new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array(10).fill(""),
                    datasets: [{
                        label: label,
                        data: Array(10).fill(null),
                        borderColor: 'rgba(0, 75, 255, 1)',
                        backgroundColor: 'rgba(0, 75, 255, 0.2)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true },
                        x: { 
                            ticks: { autoSkip: true, maxTicksLimit: 5 }
                        }
                    }
                }
            });
        }

        function powerProChart(ctx, label) {
            return new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array(10).fill(""),
                    datasets: [{
                        label: label,
                        data: Array(10).fill(null),
                        borderColor: 'rgba(255, 138, 0, 1)',
                        backgroundColor: 'rgba(255, 138, 0, 0.2)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true },
                        x: {
                            ticks: { autoSkip: true, maxTicksLimit: 5 }
                        }
                    }
                }
            });
        }

        function soundProChart(ctx, label) {
            return new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array(10).fill(""),
                    datasets: [{
                        label: label,
                        data: Array(10).fill(null),
                        borderColor: 'rgba(80, 209, 0, 1)',
                        backgroundColor: 'rgba(80, 209, 0, 0.2)',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true },
                        x: { 
                            ticks: { autoSkip: true, maxTicksLimit: 5 }
                        }
                    }
                }
            });
        }

        fetchDataAndUpdate()
    </script>



