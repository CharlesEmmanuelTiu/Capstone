<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alerts</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        .table-container {
            width: 80%;
            margin-left: 10%;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 10px;
            text-align: center;
            border: 1px solid #ddd;
        }
        th {
            background-color: lightsteelblue;
        }
        td {
            background-color: lavender;
        }
        .filters {
            margin: 20px auto;
            text-align: center;
        }
        .filters select, .filters input {
            padding: 5px;
            margin: 5px;
        }
        .icon {
            width: 10px;
            height: 10px;
        }
    </style>
</head>
<body>
    <div class="filters">
        <label for="alertTypeFilter">Alert Type:</label>
        <select id="alertTypeFilter">
            <option value="">All</option>
            <option value="Temperature Alert">Temperature Alert</option>
            <option value="Intruder Alert">Intruder Alert</option>
        </select>
        
        <label for="statusFilter">Status:</label>
        <select id="statusFilter">
            <option value="">All</option>
            <option value="Stable">Stable</option>
            <option value="Critical">Critical</option>
            <option value="Solved">Solved</option>
        </select>
        
        <label for="dateFilter">Date:</label>
        <input type="date" id="dateFilter">
        
        <button onclick="applyFilters()">Apply Filters</button>
    </div>
    
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Alert Type</th>
                    <th>Description</th>
                    <th>Source</th>
                    <th>Actions</th>
                    <th>Status</th>
                    <th>
                        <label for="sortOrder">Sort By Date:</label>
                            <select id="sortOrder" onchange="sortTable()">
                                <option value="">None</option>
                                <option value="asc">Ascending</option>
                                <option value="desc">Descending</option>
                            </select>
                    </th>
                </tr>
            </thead>
            <tbody id="alertsTable">
                {{#each alerts}}
                <tr>
                    {{#if (eq alertType "Temperature Alert")}}
                        <td><img src="https://cdn-icons-png.flaticon.com/128/5641/5641074.png" class="icon-small"></td>
                    {{else if (eq alertType "Intruder Alert")}}
                        <td><img src="https://cdn-icons-png.flaticon.com/128/2602/2602046.png" class="icon-small"></td>
                    {{else}}
                        <td>No alerts found</td>
                    {{/if}}

                    <td>{{alertType}}</td>
                    {{#if (eq alertType "Temperature Alert")}}
                        <td class="temperature-alert">Reached a temperature level of <b>{{temperature}}</b> with a recorded humidity of <b>{{humidity}}</b></td>
                    {{else if (eq  status "Stable" )}}
                        <td class="temperature-alert">Reached a stable temperature level of <b>{{temperature}}</b> with a recorded humidity of <b>{{humidity}}</b></td>
                    {{else if (eq alertType "Intruder Alert")}}
                        <td class="intruder-alert"><b>{{employee}}</b> detected in the CCTV system</td>
                    {{else}}
                        <td>Default Content</td>
                    {{/if}}

                    <td>{{source}}</td>
                    <td><a href="/actions">Actions</a></td>
                    <td>{{status}}</td>
                    <td>{{formattedTime}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <script>
        function applyFilters() {
            const alertType = document.getElementById('alertTypeFilter').value.trim();
            const status = document.getElementById('statusFilter').value.trim();
            const date = document.getElementById('dateFilter').value.trim();

            const rows = document.querySelectorAll('#alertsTable tr');

            rows.forEach(row => {
                const alertTypeCell = row.cells[1]?.textContent.trim() || '';
                const statusCell = row.cells[5]?.textContent.trim() || '';
                const dateCell = row.cells[6]?.textContent.trim() || '';

                let dateCellFormatted = '';
                if (dateCell) {
                    const parsedDate = new Date(dateCell);
                    if (!isNaN(parsedDate)) {
                        dateCellFormatted = parsedDate.toISOString().split('T')[0];
                    }
                }

                const matchesAlertType = !alertType || alertTypeCell.includes(alertType);
                const matchesStatus = !status || statusCell.includes(status);
                const matchesDate = !date || dateCellFormatted === date;

                if (matchesAlertType && matchesStatus && matchesDate) {
                    row.style.display = ''; // Show matching rows
                } else {
                    row.style.display = 'none'; // Hide non-matching rows
                }
            });
        }
        function sortTable() {
            const table = document.getElementById('alertsTable');
            const rows = Array.from(table.rows);
            const sortOrder = document.getElementById('sortOrder').value;

            rows.sort((a, b) => {
                const dateA = new Date(a.cells[6]?.textContent || '');
                const dateB = new Date(b.cells[6]?.textContent || '');
                return sortOrder === 'asc' ? dateA - dateB : dateB - dateA;
            });

            rows.forEach(row => table.appendChild(row));
        }

        //function sortTable() {
        //    const table = document.getElementById('alertsTable');
        //    const rows = Array.from(table.rows);

        //    rows.sort((a, b) => {
        //        const dateA = new Date(a.cells[6]?.textContent || '');
        //        const dateB = new Date(b.cells[6]?.textContent || '');
        //        return dateA - dateB;
        //    });

        //    rows.forEach(row => table.appendChild(row));
        //}
    </script>
</body>
</html>


