<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 2000px;
            max-height: 500px;
            overflow-y: auto;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #0056b3;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
    <script>
        function printPage() {
            const reportType = document.getElementById("filterType").value;
        }
        console.log({{{dataCenter}}})
    </script>
</head>
<body>
    <div class="print-btn">
        <button class="btn" onclick="printPage()">Print Page</button>
    </div>
    <div class="report-table">
        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Name</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                {{#each dataCenter}}
                <tr class="report-row">
                    <td>{{Category}}</td>
                    <td>{{Name}}</td>
                    <td>{{Description}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</body>
</html>
