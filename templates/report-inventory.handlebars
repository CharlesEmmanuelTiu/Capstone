<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-size: medium;
        }
        h1 {
            text-align: center;
        }
        .filter-section, .report-table {
            margin: 10px auto;
            max-width: 80%;
            max-height: 600px;
            overflow-y: auto;
        }
        .filter-section label, .filter-section input, .filter-section select {
            margin-right: 10px;
        }
        table {
            width: 100%;
            margin: auto;
            border-collapse: collapse;
            margin-top: 2px;
        }
        table, th, td {
            border: 1px solid #ccc;
            padding: 25px;
        }
        th, td {
            text-align: center;
        }
        th {
            background-color: rgba(60, 75, 100, 0.85);
            color: white;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 10px;
            color: #fff;
            background-color: #4f5d73;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #007bff;
            color: white;
        }
        .print-btn {
            margin-top: 20px;
            text-align: center;
        }
    </style>
    <script>
        function printPage() {
            const reportType = document.getElementById("filterType").value;
        }
        console.log({{{dataCenter}}})
    </script>
</head>
<body>
    <div class="print-btn">
        <button class="btn" onclick="printPage()">Print Page</button>
    </div>
    <div class="report-table">
        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Name</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody id="dataCenterTable"></tbody>
            {{!-- <tbody>
                {{#each dataCenter}}
                <tr class="report-row">
                    <td>{{Category}}</td>
                    <td>{{Name}}</td>
                    <td>{{Description}}</td>
                </tr>
                {{/each}}
            </tbody> --}}
        </table>
    </div>
<script>
    // Dynamically render the table
    function renderDataCenterTable() {
        const tableBody = document.querySelector("#dataCenterTable");
        tableBody.innerHTML = ""; // Clear previous rows

        // Parse the JSON data injected from the backend
        const datacenter = JSON.parse('{{{dataCenter}}}'); 

        // Populate the table rows
        datacenter.forEach((item) => {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${item.Category}</td>
                <td>${item.Name}</td>
                <td>${item.Description}</td>
            `;
            tableBody.appendChild(row);
        });
    }

    // Example: Call the function when the page loads
    window.onload = renderDataCenterTable;
</script>
</body>
</html>
