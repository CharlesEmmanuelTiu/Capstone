<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Center Temperature Prediction</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f9;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            padding: 20px;
        }
        .chart-container {
            width: 45%;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 20px;
        }
        canvas {
            width: 100% !important;
            height: 300px !important;
        }
        .log {
            max-height: 100px;
            overflow-y: auto;
            border: 1px solid #ccc;
            margin-top: 10px;
            padding: 5px;
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="chart-container">
            <h2>Temperature Prediction</h2>
            <canvas id="TempPrediction"></canvas>
        </div>
        <div class="chart-container">
            <h2>Humidity Prediction</h2>
            <canvas id="HumidPrediction"></canvas>
        </div>
        <div class="chart-container">
            <h2>Power Consumption Prediction</h2>
            <canvas id="PowerPrediction"></canvas>
        </div>
    </div>
<script>
    async function fetchPredictedData() {
        try {
            const response2 = await fetch('http://127.0.0.1:5005/data');
            const response = await fetch('http://localhost:5000/predict', {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' },
            });

            if (!response.ok) {
                const errorData = await response.json();
                console.error("Error from server:", errorData.error);
                return; // Exit if the server returns an error
            }
            const data = await response.json();
            console.log(data)
            const TempPredictions = data.temperature_predictions;
            const HumidPredictions = data.humidity_predictions;
            const PowerPredictions = data.power_predictions;
            const timeLabels = data.future_dates;  // Get the time labels
            
            // Update the chart with new data if predictions are valid
            if (TempPredictions && TempPredictions.length > 0 && timeLabels && timeLabels.length > 0) {
                updateChart(TempPredictions, HumidPredictions, PowerPredictions, timeLabels);
            }
        } catch (error) {
            console.error("Error fetching data:", error);
        }
    }


    function updateChart(TempPredictions, HumidPredictions, PowerPredictions, timeLabels) {
        const maxDataPoints = 30;  // Maximum number of data points to display

        // Limit the data to the latest maxDataPoints
        TempPredictions = TempPredictions.slice(-maxDataPoints);
        HumidPredictions = HumidPredictions.slice(-maxDataPoints);
        PowerPredictions = PowerPredictions.slice(-maxDataPoints);
        timeLabels = timeLabels.slice(-maxDataPoints);

        // Update chart with the limited data
        TempPredictionChart.data.labels = timeLabels;
        HumidPredictionsChart.data.labels = timeLabels;
        PowerPredictionsChart.data.labels = timeLabels;

        TempPredictionChart.data.datasets[0].data = TempPredictions;
        HumidPredictionsChart.data.datasets[0].data = HumidPredictions;
        PowerPredictionsChart.data.datasets[0].data = PowerPredictions;

        TempPredictionChart.update();
        HumidPredictionsChart.update();
        PowerPredictionsChart.update();
    }

    // Create and update the line chart
    const ctx = document.getElementById('TempPrediction').getContext('2d');
    const TempPredictionChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [],  // Dynamic labels
            datasets: [
                {
                    label: 'Temperature',
                    data: [],
                    borderColor: 'rgba(255, 0, 0, 1)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                x: { title: { display: true, text: 'Time' } },
                y: { title: { display: true, text: 'Temperature (°C)' } }
            }
        }
    });
    const ctx2 = document.getElementById('HumidPrediction').getContext('2d');
    const HumidPredictionsChart = new Chart(ctx2, {
        type: 'line',
        data: {
            labels: [],  // Dynamic labels
            datasets: [
                {
                    label: 'Humidity',
                    data: [],
                    borderColor: 'rgba(0, 75, 255, 1)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                x: { title: { display: true, text: 'Time' } },
                y: { title: { display: true, text: 'Humidity (°C)' } }
            }
        }
    });
    const ctx3 = document.getElementById('PowerPrediction').getContext('2d');
    const PowerPredictionsChart = new Chart(ctx3, {
        type: 'line',
        data: {
            labels: [],  // Dynamic labels
            datasets: [
                {
                    label: 'Power',
                    data: [],
                    borderColor: 'rgba(255, 138, 0, 1)',
                    fill: false,
                    pointRadius: 0, // Remove dots
                }
            ]
        },
        options: {
            responsive: true,
            scales: {
                x: { title: { display: true, text: 'Time' } },
                y: { title: { display: true, text: 'Power (kW)' } }
            }
        }
    });
    // Fetch data every second
    fetchPredictedData();
    setInterval(fetchPredictedData, 1000)
</script>

</body>
</html>